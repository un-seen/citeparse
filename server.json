{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.un-seen/citeparse",
  "title": "citeparse",
  "description": "Parse reference lists to CSL-JSON or BibTeX locally, and flag citations that point to no real work.",
  "repository": {
    "url": "https://github.com/un-seen/citeparse",
    "source": "github",
    "id": "1464134812"
  },
  "websiteUrl": "https://huggingface.co/spaces/hedwigai/citeparse",
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "citeparse",
      "version": "0.2.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "CITEPARSE_MAILTO",
          "description": "Your email, sent to Crossref and OpenAlex so they can reach you (polite pool)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "OPENALEX_API_KEY",
          "description": "OpenAlex API key; without one the shared free budget is small",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "CITEPARSE_MODEL",
          "description": "hedwigai/citeparse-32m (default) or hedwigai/citeparse-150m",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "default": "hedwigai/citeparse-32m"
        }
      ]
    }
  ]
}
